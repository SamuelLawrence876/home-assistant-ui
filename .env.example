# Copy this file to .env.local and fill in real values.
# .env.local is gitignored via the `*.local` rule in .gitignore.

# Home Assistant URL — used by both `npm run dev` and `npm run build`.
#   - Dev/LAN:  http://192.168.0.79:8123
#   - Prod:     https://sam.taile7763b.ts.net  (Tailscale Funnel, hit directly;
#                                               injected in CI via the
#                                               VITE_HA_URL repo variable)
#   - Mock:     leave empty to build the offline GH_DATA mode that the
#               scripts/shoot.mjs screenshot harness uses.
VITE_HA_URL=http://192.168.0.79:8123

# Spotify Web API client id — powers search/playlists/queue on the Media tab.
# Public by design (PKCE flow, no secret). Injected in CI via the
# VITE_SPOTIFY_CLIENT_ID repo variable.
VITE_SPOTIFY_CLIENT_ID=

# Auth: handled at runtime via HA's OAuth flow (home-assistant-js-websocket).
# Tokens are stored in localStorage under `ha_tokens` and auto-refreshed.
# No token env var is needed — the app redirects to HA's login on first visit.
#
# RETIRED: VITE_HA_TOKEN. Phase 1 kept a long-lived HA token here; the OAuth
# refactor removed every reader of it and it was deleted on 2026-08-04.
# Do not reintroduce it — a long-lived token bypasses OAuth and the role
# gating in src/lib/roles.js entirely, and never expires on its own.
